# =====================================================
# TravelFootprint 数据库连接配置示例
# =====================================================
# 使用方法：
#   1. 复制本文件，重命名为 db.properties（去掉 .example 后缀）
#   2. 把下面的账号密码改成你自己的
#
# 说明：
#   - db.properties 已被 .gitignore 忽略，不会被提交到 git；
#   - 也可以不建文件，改用环境变量 TRAVEL_DB_URL / TRAVEL_DB_USER / TRAVEL_DB_PASSWORD，
#     环境变量的优先级高于本文件。

jdbc.url=jdbc:mysql://localhost:3306/travel?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8
jdbc.user=root
jdbc.password=你的密码
